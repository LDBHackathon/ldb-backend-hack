PROD_ENV=false
SECRET_KEY=change-me
DB_URL=postgresql://ldb:ldb@localhost:5432/ldb_dva
REDIS_URL=redis://localhost:6379/0

# Bootstrap-only: seeds default merchant + API key on first startup (migration from single-tenant dev)
LDB_API_KEY=dev-api-key
DEFAULT_MERCHANT_ID=00000000-0000-0000-0000-000000000001

# Dashboard session JWT (portal /auth/*)
SESSION_COOKIE_NAME=ldb_session
SESSION_JWT_EXPIRY_HOURS=24

# Nomba TEST (sandbox) — use until you go live
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
# Legacy fallback when customer has no per-user sub-account (prefer per-customer provisioning)
NOMBA_SUB_ACCOUNT_ID=
NOMBA_WEBHOOK_SECRET=

# For LIVE: set PROD_ENV=true, NOMBA_BASE_URL=https://api.nomba.com, and LIVE credentials

# Cloudinary file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ALLOWED_ORIGINS=["http://localhost:3000"]
NIGHTLY_RECONCILIATION_HOUR=2

# Production server listens on host port 8080 (see docker-compose.prod.yml, env file: .env-hack)
# Development server listens on host port 8070 (see docker-compose.dev.yml, env file: .env-dev)

